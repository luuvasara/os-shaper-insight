# An apply that was waiting for its confirmation when the firewall stopped was never
# confirmed: put its restore point back (os-shaper-insight).
if [ -f /conf/shaperinsight-apply.json ]; then
	# the result always goes to the system log, so a failed recovery is never silent (review S13)
	out=$(/usr/local/opnsense/scripts/shaperinsight/apply.py boot 2>&1)
	logger -t shaperinsight "boot recovery (rc $?): ${out}"
fi

# the history sampler (it exits at once when switched off in the settings)
out=$(/usr/local/opnsense/scripts/shaperinsight/sampler.py start 2>&1)
logger -t shaperinsight "sampler start at boot: ${out}"
