# os-shaper-insight, after the package files are gone. Only the runtime pieces that cannot
# work without the plugin go; the configuration, the ledger and restore points in /conf and
# the bufferbloat results in /var/db stay (OPNsense convention: config survives uninstall).
if [ -z "${PKG_UPGRADE}" ]; then
	rm -f /var/run/shaperinsight.lock /var/run/shaperinsight-apply.lock \
	    /var/run/shaperinsight-bb.lock /var/run/shaperinsight-prio.lock \
	    /var/run/shaperinsight-prio.json /var/run/shaperinsight-ipfw-reload \
	    /var/run/shaperinsight-prio.removing
	rm -rf /var/run/shaperinsight /var/run/shaperinsight-bb \
	    /usr/local/opnsense/scripts/shaperinsight/__pycache__ \
	    /usr/local/opnsense/scripts/shaperinsight/lib/__pycache__
	# pkg removes the then empty directories itself (removing them here makes it warn)
	# rc.conf.d/ipfw is gone, so core's own rule script runs at the next reload; the marks were
	# already purged before the delete, so no reload is needed now (it would zero every rule
	# counter, review N5). Cron is rebuilt only when it still has the priority refresh job.
	if crontab -l -u root 2>/dev/null | grep -q shaperinsight; then
		/usr/local/sbin/configctl cron restart >/dev/null 2>&1
	fi
fi
