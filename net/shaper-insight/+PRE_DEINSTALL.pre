# os-shaper-insight, before the package files go, while our scripts still exist. A plugin
# leaves its configuration on uninstall (OPNsense convention), and opnsense/plugins'
# "make upgrade" is pkg delete + pkg add, so this never touches a confirmed setup. It only:
#  - ends a PENDING apply countdown by reverting it (that change was never accepted),
#  - stops a running bufferbloat test,
#  - unloads the priority marks (ipfw set 7 and its tables): the shaper keeps running,
#    priorities fall back to "everything alike" until the plugin is back.
# The ledger stays in /conf, so after a reinstall Remove still takes Shaper Insight's objects
# away. To take the shaping away, press Remove on the setup page BEFORE uninstalling.
# a package upgrade replaces the files and keeps everything running: nothing to do
[ -n "${PKG_UPGRADE}" ] && exit 0
APPLY=/usr/local/opnsense/scripts/shaperinsight/apply.py
STATE=/conf/shaperinsight-apply.json
if [ -x "${APPLY}" ]; then
	# fail closed (review S1): exit 1 or output without '"status": "ok"' is a failure. It stops
	# pkg while an apply may still be pending (removing the scripts would leave an unconfirmed
	# change for good); otherwise it is reported and the uninstall goes on, so a broken script
	# cannot block removal forever. SHAPERINSIGHT_FORCE_REMOVE=1 overrides the stop.
	out=$("${APPLY}" uninstall 2>&1)
	rc=$?
	echo "Shaper Insight: ${out}"
	logger -t shaperinsight "uninstall (rc ${rc}): ${out}"
	case ${out} in
	*'"status": "ok"'*) ok=1 ;;
	*) ok=0 ;;
	esac
	if [ "${rc}" -ne 0 ] || [ "${ok}" -ne 1 ]; then
		pending=0
		case ${out} in
		*'"status": "failed"'*) pending=1 ;;	# its own answer: an apply still holds the lock
		esac
		# a crash says nothing: look at the state file (pending, or unreadable = assume pending)
		if [ -f "${STATE}" ] && { grep -Eq '"state": "(waiting|running|reverting)"' "${STATE}" ||
		    ! grep -q '"state"' "${STATE}"; }; then
			pending=1
		fi
		if [ "${pending}" -eq 1 ] && [ -z "${SHAPERINSIGHT_FORCE_REMOVE}" ]; then
			echo "Shaper Insight: uninstall stopped: an apply may still be waiting for its confirmation, and"
			echo "  removing the plugin now could leave that change in place for good. Confirm or wait"
			echo "  for it, then uninstall again. To remove anyway: SHAPERINSIGHT_FORCE_REMOVE=1 pkg delete ..."
			exit 1
		fi
		echo "Shaper Insight: the uninstall step failed, but no apply is pending; continuing."
	fi
	# the history sampler stops before its script goes; its RRDs stay in /var/db/rrd like
	# core's own (Reporting: Settings can reset them)
	# stop escalates to SIGKILL after 5 s; a failure is logged, not ignored (Verification 4)
	if ! /usr/local/opnsense/scripts/shaperinsight/sampler.py stop | grep -q '"running": false'; then
		/usr/bin/logger -t shaperinsight "sampler: could not be stopped before uninstall; it ends itself within 10 s when its package is gone"
	fi
	# the priority refresh job goes now: prio.py purge left its "removing" flag, so the cron
	# hook returns nothing (review S4)
	/usr/local/sbin/configctl cron restart >/dev/null 2>&1 || true
fi
